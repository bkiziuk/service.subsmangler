msgctxt "#32110"
msgid "Automatically open subtitles search dialog when playback is started"
msgstr "Automaticky otevřít dialog pro vyhledávání titulků při spuštění přehrávání"

msgctxt "#32111"
msgid "Automatically open subtitle search dialog when playing internet stream"
msgstr "Automaticky otevřít dialog pro vyhledávání titulků při přehrávání internetového streamu"

msgctxt "#32112"
msgid "Search dialog will not be opened if local unprocessed subtitles are available"
msgstr "Vyhledávací dialog se neotevře, pokud jsou k dispozici místní nezpracované titulky"

msgctxt "#32113"
msgid "If subtitles were not downloaded after closing search dialog, the confirmation dialog asking if search dialog should be opened the next time this file is played back, will not be displayed"
msgstr "Pokud po zavření vyhledávacího dialogu nebyly staženy titulky, potvrzovací dialog s dotazem, zda se má vyhledávací dialog otevřít při příštím přehrání tohoto souboru, se nezobrazí"

msgctxt "#32114"
msgid "What level of logs should be written to the log file"
msgstr "Jakou úroveň protokolování použít pro soubor protokolu"

msgctxt "#32115"
msgid "Place where addon's logs should be stored"
msgstr "Místo, kam se mají ukládat protokoly doplňku"

msgctxt "#32116"
msgid "Option for managing 'noautosubs' flag will be available in the context menu"
msgstr "Volba pro správu příznaku 'noautosubs' bude k dispozici v kontextové nabídce"

msgctxt "#32117"
msgid "If enabled, addon will try to convert subtitles"
msgstr "Pokud je tato volba povolena, doplněk se pokusí převést titulky"

msgctxt "#32118"
msgid "Addon will try to convert locally available subtitles if they are present instead of opening subtitle search dialog"
msgstr "Doplněk se pokusí převést lokálně dostupné titulky, pokud jsou k dispozici, místo otevření dialogu pro vyhledávání titulků"

msgctxt "#32119"
msgid "Closed Captioning will be removed from subtitles file"
msgstr "Ze souboru titulků budou odstraněny skryté titulky"

msgctxt "#32120"
msgid "Advertisement texts matching loaded RegEx filters will be removed from subtitles file"
msgstr "Reklamní texty odpovídající načteným filtrům RegEx budou odstraněny ze souboru titulků"

msgctxt "#32121"
msgid "Time for displaying subtitle entry will be increased if it is below calculated minimum value"
msgstr "Doba zobrazení položky titulků se prodlouží, pokud je pod vypočtenou minimální hodnotou"

msgctxt "#32122"
msgid "Time for displaying subtitle entry will be shrunk if it overlaps the next subtitle line"
msgstr "Doba zobrazení položky titulků se zkrátí, pokud se překrývá s dalším řádkem titulků"

msgctxt "#32123"
msgid "Pause playback during subtitle conversion"
msgstr "Pozastavit přehrávání během převodu titulků"

msgctxt "#32124"
msgid "Leave a backup copy of original subtitle file before processing it instead of removing it"
msgstr "Ponechat záložní kopii původního souboru titulků před jeho zpracováním místo jeho odstranění"

msgctxt "#32125"
msgid "Automatically update filtering definitions from the Internet"
msgstr "Automaticky aktualizovat definice filtrů z internetu"

msgctxt "#32126"
msgid "Remove subtitle file backups if associated video is deleted"
msgstr "Odstranit záložní soubory titulků, pokud je související video smazáno"

msgctxt "#32127"
msgid "Remove original subtitle files if associated video is deleted"
msgstr "Odstranit původní soubory titulků, pokud je související video smazáno"

msgctxt "#32128"
msgid "If enabled, no files will be removed but only a log entry will be created"
msgstr "Pokud je povoleno, nebudou odstraněny žádné soubory, pouze se vytvoří záznam v protokolu"

msgctxt "#32129"
msgid "Periodically remove subtitle files if matching video files are not present any more"
msgstr "Pravidelně odstraňovat soubory titulků, pokud už nejsou k dispozici odpovídající video soubory"

msgctxt "#32130"
msgid "Behaviour when video is started"
msgstr "Chování při spuštění videa"

msgctxt "#32131"
msgid "Options for customizing conversion behaviour"
msgstr "Možnosti přizpůsobení chování při převodu"

msgctxt "#32132"
msgid "Behaviour when video file is no longer available"
msgstr "Chování, když video soubor už není dostupný"

msgctxt "#32133"
msgid "Hides the cleaning progress bar"
msgstr "Skryje ukazatel průběhu čištění"

