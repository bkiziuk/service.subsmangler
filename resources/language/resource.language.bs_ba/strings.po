msgstr "Napravite sigurnosnu kopiju obrađene datoteke titlova"

msgctxt "#32072"
msgid "Remove backed-up copy of orphaned subtitle file"
msgstr "Uklonite sigurnosnu kopiju osiroćene datoteke titlova"

msgctxt "#32073"
msgid "Simulate file removal only"
msgstr "Simuliraj samo uklanjanje datoteka"

msgctxt "#32074"
msgid "Remove orphaned unprocessed subtitle files"
msgstr "Uklonite neobrađene datoteke titlova koje nisu obrađene"

msgctxt "#32075"
msgid "Try to maintain bigger line spacing"
msgstr "Pokušajte održavati veći razmak između redova"

msgctxt "#32076"
