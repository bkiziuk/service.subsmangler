msgstr "Konverzija"

msgctxt "#32081"
msgid "Adjust subtitle display time"
msgstr "Podesite vrijeme prikaza titlova"

msgctxt "#32082"
msgid "Shrink overlapping subtitle time"
msgstr "Smanji vrijeme preklapanja titlova"

msgctxt "#32090"
